SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required only for admin user management (creating/deleting auth users).
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: legacy HS256 JWT secret. When unset, tokens are verified against
# the project's JWKS endpoint (asymmetric signing keys).
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
