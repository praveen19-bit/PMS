# Demo mode runs the app with sample data in your browser — no Supabase or
# backend needed. It is also used automatically while the Supabase values below
# are missing or still the placeholders.
# To use a real Supabase project: set VITE_DEMO_MODE=false and fill in the values.
VITE_DEMO_MODE=true
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000
